#REQUIRED
DISCORD_TOKEN =
DISCORD_CLIENT_ID =
DATABASE_CONNECTION_STRING =
DATABASE_USER =
DATABASE_PASSWORD =
#OPTIONAL
DATABASE_NAME = "stroycord"
PREFIX = "&"
DETECT_FROM_ALL_MESSAGES = false
LOG_DIR = "./logs"
LANGUAGE = "en-US"
STROYCORD_LOGO = "https://destroykeaum.alwaysdata.net/assets/other/stroybot_logo.png"
#DOCKER
TIMEZONE = "Europe/Paris"
# Optional — path to a cookies.txt file exported from YouTube (Netscape format)
# Used by yt-dlp for age-restricted videos
# YOUTUBE_COOKIES_PATH=./cookies.txt
# Optional — bgutil PoToken provider URL (docker-compose starts one at http://bgutil-provider:4416)
# BGUTIL_BASE_URL=http://127.0.0.1:4416
#MONITORING (optional)
# GlitchTip project DSN — error reporting is disabled when empty
GLITCHTIP_DSN =
GLITCHTIP_ENVIRONMENT = "production"
# GLITCHTIP_RELEASE = "1.5.3"
