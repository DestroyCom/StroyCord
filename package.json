{
  "name": "stroycord",
  "version": "1.5.3",
  "engines": {
    "node": ">=24"
  },
  "description": "A discord bot to play music in VC",
  "main": "src/Bot.ts",
  "scripts": {
    "dev": "tsx watch ./src/Bot.ts",
    "start": "node ./dist/Bot.js",
    "build": "npm run lint && tsup ./src/Bot.ts --minify",
    "lint": "biome check --write .",
    "lint:ci": "biome ci .",
    "test": "vitest run",
    "test:functional": "vitest run src/tests/functional",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "knip": "knip",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:rebuild": "docker compose up -d --build",
    "docker:logs": "docker compose logs -f stroycord",
    "docker:test-env": "docker compose up -d mongodb mongo-express",
    "docker:test-env-down": "docker compose stop mongodb mongo-express",
    "docker:clean": "docker compose down -v"
  },
  "author": "Dest.Com",
  "license": "GPL-3.0",
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@sentry/node": "11.8.0",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "i18n-js": "4.5.4",
    "libsodium-wrappers": "0.8.4",
    "mongodb": "7.7.0",
    "mongoose": "9.11.2",
    "youtube-dl-exec": "^3.1.17",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "mongodb-memory-server": "11.3.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
